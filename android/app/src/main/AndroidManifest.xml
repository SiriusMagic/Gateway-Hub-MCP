<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Automatic linking (Redireccionar a Hub). Declared here too, so it exists whichever app is installed
         first; "signature" means only apps signed with the same key ever get it. -->
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/link_permission" />
    <uses-permission android:name="com.zirakusa.gatewayhub.permission.LINK" />
    <!-- Asistente: the microphone only while the user holds a conversation; contacts only for «llama a Ana». -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- «Pon una alarma a las 7» with Android's standard order (Reloj or the phone's clock). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The family's «Hoy» summaries (weather, agenda…), only from apps signed with the same key. -->
    <uses-permission android:name="com.zirakusa.family.permission.SUMMARY" />
    <!-- The family's own orders (FAMILIA.md §10), only between apps signed with the same key. -->
    <permission android:name="com.zirakusa.family.permission.ACT" android:protectionLevel="signature"
        android:label="@string/act_permission" />
    <uses-permission android:name="com.zirakusa.family.permission.ACT" />
    <!-- Package visibility limited to apps that declare Gateway Hub support and the family apps (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent><action android:name="com.zirakusa.gatewayhub.action.APP" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
        <package android:name="com.zirakusa.stone" />
        <package android:name="com.zirakusa.stone.kotlin.preview" />
        <package android:name="com.zirakusa.stone.video" />
        <package android:name="app.luma.gallery" />
        <package android:name="com.zirakusa.camara" />
        <package android:name="com.zirakusa.reloj" />
        <package android:name="com.zirakusa.calendario" />
        <package android:name="com.zirakusa.clima" />
        <package android:name="com.zirakusa.notas" />
        <package android:name="com.zirakusa.filem" />
        <package android:name="com.zirakusa.calculadora" />
        <package android:name="com.zirakusa.contactos" />
        <package android:name="com.zirakusa.telefono" />
        <package android:name="com.zirakusa.sms" />
        <package android:name="com.zirakusa.qr" />
        <package android:name="com.zirakusa.redes" />
        <package android:name="com.zirakusa.brujula" />
        <package android:name="com.zirakusa.nivel" />
        <package android:name="com.zirakusa.launcher" />
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher" android:theme="@style/Theme.GatewayHub"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Asistente: its own icon, and the phone's assist gesture when chosen as the assistant. -->
        <activity android:name=".assistant.AssistantActivity" android:exported="true" android:label="@string/assistant"
            android:icon="@mipmap/ic_launcher" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize"
            android:taskAffinity="com.zirakusa.gatewayhub.assistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
