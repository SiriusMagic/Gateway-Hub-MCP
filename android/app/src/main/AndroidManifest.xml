<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "MCP en segundo plano": a service with a persistent notification, only when the person picks that mode. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Automatic linking (Redirección hub). Declared here too, so it exists whichever app is installed
         first; "signature" means only apps signed with the same key ever get it. -->
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/link_permission" />
    <uses-permission android:name="com.zirakusa.gatewayhub.permission.LINK" />
    <!-- Package visibility limited to apps that declare Gateway Hub support (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent><action android:name="com.zirakusa.gatewayhub.action.APP" /></intent>
        <!-- Local MCP bridge (Messenger service) of those same apps. -->
        <intent><action android:name="com.zirakusa.gatewayhub.action.MCP" /></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher" android:theme="@style/Theme.GatewayHub"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".watch.HubWatchService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows that the owner's MCP environment is active and lets the owner pause or disconnect it from the notification." />
        </service>
    </application>
</manifest>
